# Public application
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=RAC Insutech
RFQ_RECIPIENT_EMAIL=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Development-only fallbacks. Never enable these in production.
NEXT_PUBLIC_ENABLE_DEV_MOCKS=true

# Local development Admin only. Change all three in .env.local before sharing
# a development environment. Production Admin access always uses Supabase.
RAC_DEVELOPMENT_ADMIN_EMAIL=admin@racinsutech.test
RAC_DEVELOPMENT_ADMIN_PASSWORD=RacAdmin@2026!
RAC_DEVELOPMENT_SESSION_SECRET=replace-this-with-a-long-random-local-secret

# Quotation generator
# Prices are managed through database/quotation-rate-card-template.csv and the
# quotation_rate_cards table after Supabase is configured. No credentials or
# production rates are stored in this repository.
NEXT_PUBLIC_QUOTATION_GST_RATE=18
