{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rac-insutech-v2",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "racinsutech.com/*",
      "zone_name": "racinsutech.com"
    },
    {
      "pattern": "www.racinsutech.com/*",
      "zone_name": "racinsutech.com"
    }
  ]
}
